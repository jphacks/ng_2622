{
  "openapi": "3.1.0",
  "info": {
    "title": "ScenEnglish backend",
    "description": "部屋の作成と参加、ラウンドの進行の API。WebSocket（GET /rooms/{roomId}/ws）で流れるメッセージは OpenAPI の paths では表せないので、components.schemas の ClientMessage（iPhone → 部屋）と ServerMessage（部屋 → iPhone）に型だけを載せている。",
    "version": "0.1.0",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "security": [],
  "servers": [
    {
      "url": "/",
      "description": "この API を返しているサーバー"
    }
  ],
  "components": {
    "responses": {
      "ClientMessage": {
        "description": "WebSocket で iPhone から部屋へ送るメッセージ",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ClientMessage"
            }
          }
        }
      },
      "ServerMessage": {
        "description": "WebSocket で部屋から iPhone へ届くメッセージ",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ServerMessage"
            }
          }
        }
      }
    },
    "schemas": {
      "PlayerName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20,
        "description": "表示名（1〜20 文字）",
        "example": "はなこ"
      },
      "PlayerId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "部屋の中での参加者の ID"
      },
      "PlayerToken": {
        "type": "string",
        "minLength": 1,
        "description": "参加者ごとの合言葉。切断からの復帰とホストの確認に使う。他の人に見せない"
      },
      "JoinMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "join"
          },
          "name": {
            "$ref": "#/components/schemas/PlayerName"
          },
          "playerId": {
            "$ref": "#/components/schemas/PlayerId"
          },
          "token": {
            "$ref": "#/components/schemas/PlayerToken"
          }
        },
        "required": [
          "type",
          "name"
        ],
        "additionalProperties": false,
        "description": "接続したら最初に送る。ホストは POST /rooms で受け取った playerId と token を、切断から戻る人は welcome で受け取ったものを付ける。初めて入る人は name だけ"
      },
      "SceneId": {
        "type": "string",
        "minLength": 1,
        "description": "シーンの ID（シーンの JSON の id）",
        "example": "park"
      },
      "StartMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "start"
          },
          "sceneId": {
            "$ref": "#/components/schemas/SceneId"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "description": "ホストだけが送れる。待合のときだけ有効"
      },
      "ClientMessage": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/JoinMessage"
          },
          {
            "$ref": "#/components/schemas/StartMessage"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "join": "#/components/schemas/JoinMessage",
            "start": "#/components/schemas/StartMessage"
          }
        }
      },
      "WelcomeMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "welcome"
          },
          "playerId": {
            "$ref": "#/components/schemas/PlayerId"
          },
          "token": {
            "$ref": "#/components/schemas/PlayerToken"
          },
          "isHost": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "playerId",
          "token",
          "isHost"
        ],
        "additionalProperties": false,
        "description": "join を受け付けたら本人にだけ送る。playerId と token は端末に保存し、切断から戻るときの join に付ける"
      },
      "RoomPhase": {
        "type": "string",
        "enum": [
          "lobby",
          "playing",
          "waiting",
          "results"
        ],
        "description": "部屋の進み具合。lobby: 待合、playing: 回転と録音、waiting: 採点待ち、results: 結果発表"
      },
      "Player": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/PlayerId"
          },
          "name": {
            "$ref": "#/components/schemas/PlayerName"
          },
          "isHost": {
            "type": "boolean"
          },
          "connected": {
            "type": "boolean",
            "description": "false のときは切断中（復帰を待っている）"
          }
        },
        "required": [
          "id",
          "name",
          "isHost",
          "connected"
        ],
        "additionalProperties": false
      },
      "RoomMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "room"
          },
          "roomId": {
            "$ref": "#/components/schemas/RoomId"
          },
          "phase": {
            "$ref": "#/components/schemas/RoomPhase"
          },
          "hostId": {
            "$ref": "#/components/schemas/PlayerId"
          },
          "maxPlayers": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "example": 5
          },
          "players": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Player"
            }
          }
        },
        "required": [
          "type",
          "roomId",
          "phase",
          "hostId",
          "maxPlayers",
          "players"
        ],
        "additionalProperties": false,
        "description": "部屋の様子。参加者や状態が変わるたびに全員へ送る"
      },
      "RoundMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "round"
          },
          "round": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "この部屋で何回目のラウンドか"
          },
          "sceneId": {
            "$ref": "#/components/schemas/SceneId"
          },
          "startAt": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "format": "int64",
            "description": "回転を始める時刻（UNIX 時刻のミリ秒）。全員がこの時刻にそろって始める",
            "example": 1792800000000
          }
        },
        "required": [
          "type",
          "round",
          "sceneId",
          "startAt"
        ],
        "additionalProperties": false,
        "description": "ホストがスタートしたら全員へ送る"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "room_not_found",
          "room_full",
          "invalid_message",
          "unauthorized",
          "not_host",
          "not_in_lobby",
          "unknown_scene",
          "server_busy"
        ],
        "description": "room_not_found: 部屋が無い\nroom_full: 満員\ninvalid_message: メッセージの形が違う\nunauthorized: 参加者の ID と合言葉が合わない\nnot_host: ホストだけができる操作\nnot_in_lobby: 待合でしかできない操作\nunknown_scene: シーンの ID が無い\nserver_busy: 空いている部屋のコードが無い"
      },
      "ErrorMessage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "error"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "code",
          "message"
        ],
        "additionalProperties": false,
        "description": "受け付けられなかった操作を、送った本人にだけ返す"
      },
      "ServerMessage": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/WelcomeMessage"
          },
          {
            "$ref": "#/components/schemas/RoomMessage"
          },
          {
            "$ref": "#/components/schemas/RoundMessage"
          },
          {
            "$ref": "#/components/schemas/ErrorMessage"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "welcome": "#/components/schemas/WelcomeMessage",
            "room": "#/components/schemas/RoomMessage",
            "round": "#/components/schemas/RoundMessage",
            "error": "#/components/schemas/ErrorMessage"
          }
        }
      },
      "CreateRoomResponse": {
        "type": "object",
        "properties": {
          "roomId": {
            "$ref": "#/components/schemas/RoomId"
          },
          "playerId": {
            "$ref": "#/components/schemas/PlayerId"
          },
          "token": {
            "$ref": "#/components/schemas/PlayerToken"
          }
        },
        "required": [
          "roomId",
          "playerId",
          "token"
        ],
        "additionalProperties": false,
        "description": "作った部屋と、ホストとして入るための ID と合言葉。続けて WebSocket の join で送る"
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "RoomSummary": {
        "type": "object",
        "properties": {
          "roomId": {
            "$ref": "#/components/schemas/RoomId"
          },
          "phase": {
            "$ref": "#/components/schemas/RoomPhase"
          },
          "playerCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxPlayers": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "example": 5
          }
        },
        "required": [
          "roomId",
          "phase",
          "playerCount",
          "maxPlayers"
        ],
        "additionalProperties": false,
        "description": "部屋に入る前の確認用（あるか、満員でないか）"
      },
      "RoomId": {
        "type": "string",
        "pattern": "^\\d{4}$",
        "description": "部屋のコード（数字 4 桁）",
        "example": "0427"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "system"
        ],
        "summary": "動いているかの確認",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/rooms": {
      "post": {
        "operationId": "createRoom",
        "tags": [
          "rooms"
        ],
        "summary": "部屋を作る",
        "description": "部屋を作り、部屋のコードと、ホストとして入るための ID と合言葉を返す。",
        "responses": {
          "201": {
            "description": "作った",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRoomResponse"
                }
              }
            }
          },
          "503": {
            "description": "空いている部屋のコードが無い（server_busy）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rooms/{roomId}": {
      "get": {
        "operationId": "getRoom",
        "tags": [
          "rooms"
        ],
        "summary": "部屋があるかを確かめる",
        "description": "部屋に入る画面で、コードが合っているか、満員でないかを確かめる。",
        "responses": {
          "200": {
            "description": "ある",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomSummary"
                }
              }
            }
          },
          "400": {
            "description": "部屋のコードの形が違う（invalid_message）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "部屋が無い（room_not_found）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "roomId",
            "schema": {
              "$ref": "#/components/schemas/RoomId"
            },
            "required": true,
            "description": "部屋のコード（数字 4 桁）"
          }
        ]
      }
    },
    "/rooms/{roomId}/ws": {
      "get": {
        "operationId": "connectRoom",
        "tags": [
          "rooms"
        ],
        "summary": "WebSocket で部屋に入る",
        "description": "WebSocket に切り替える。つないだら最初に JoinMessage を送る。以後のメッセージの型は components.schemas の ClientMessage と ServerMessage。",
        "responses": {
          "101": {
            "description": "WebSocket に切り替えた"
          },
          "400": {
            "description": "部屋のコードの形が違う（invalid_message）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "部屋が無い（room_not_found）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "426": {
            "description": "WebSocket の接続ではない（invalid_message）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "roomId",
            "schema": {
              "$ref": "#/components/schemas/RoomId"
            },
            "required": true,
            "description": "部屋のコード（数字 4 桁）"
          }
        ]
      }
    }
  }
}
