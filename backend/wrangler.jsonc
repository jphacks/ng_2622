{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ng-2622-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "observability": {
    "enabled": true
  },
  // 採点の設定。SCORING_MODE は "live"（Azure と Claude を呼ぶ）か "fixed"（固定の点数）。
  // 本番は live。PR のプレビューは料金を抑えるため fixed（下の previews）。AZURE_LOCATION は Azure のリソースのリージョン
  "vars": {
    "SCORING_MODE": "live",
    "SCORE_WEIGHTS": "50,25,25",
    "AZURE_LOCATION": "japaneast"
  },
  // SCENE_REVIEWS はシーンの評価（全シーンで 1 つ）
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "SCENE_REVIEWS", "class_name": "SceneReviews" }
    ]
  },
  // 無料プランは SQLite 版のみ。出した tag は書き換えず、新しい tag で足す
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["SceneReviews"] }
  ],
  // PR ごとのプレビュー（wrangler preview）の設定。vars や DO の binding は上の階層から引き継がれないので、
  // プレビューでも使うものはここにも書く
  "previews": {
    "vars": {
      "SCORING_MODE": "fixed",
      "SCORE_WEIGHTS": "50,25,25"
    },
    "durable_objects": {
      "bindings": [
        { "name": "ROOM", "class_name": "Room" },
        { "name": "SCENE_REVIEWS", "class_name": "SceneReviews" }
      ]
    }
  }
}
