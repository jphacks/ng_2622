{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ng-2622-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "observability": {
    "enabled": true
  },
  // 採点の設定。SCORING_MODE は "live"（Azure と Claude を呼ぶ）か "fixed"（固定の点数）。
  // 本番は live。PR のプレビューは料金を抑えるため fixed（下の previews）。AZURE_LOCATION は Azure のリソースのリージョン
  // CLAUDE_MODEL・CLAUDE_EFFORT は採点に使う Claude。Haiku 5.5 の high は 1 回 7〜8 秒かかったので、Sonnet 5.5 の low（3〜4 秒）にしている
  // SCENE_GENERATION は "on" のときだけ場面を AI で作る。POST /scenes/generate（それ以外は 503）と、
  // 部屋が難易度のスタートで作る生成（それ以外は作り置きの場面から選ぶ）の両方のスイッチ。
  // 作り置きは手元の wrangler dev で行う。部屋での生成を出すまで、デプロイ先では off のままにする
  "vars": {
    "SCORING_MODE": "live",
    "SCORE_WEIGHTS": "50,25,25",
    "AZURE_LOCATION": "japaneast",
    "CLAUDE_MODEL": "claude-sonnet-5-5",
    "CLAUDE_EFFORT": "low",
    "SCENE_GENERATION": "off"
  },
  // SCENE_REVIEWS はシーンの評価（全シーンで 1 つ）
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "SCENE_REVIEWS", "class_name": "SceneReviews" }
    ]
  },
  // 無料プランは SQLite 版のみ。出した tag は書き換えず、新しい tag で足す
  // v4: 配置から作った採点の基準を場面ごとに覚えるのをやめた（採点基準の段階で付けるため）。中身は 1 日で消える基準だけ
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["SceneReviews"] },
    { "tag": "v3", "new_sqlite_classes": ["SceneRubrics"] },
    { "tag": "v4", "deleted_classes": ["SceneRubrics"] }
  ],
  // PR ごとのプレビュー（wrangler preview）の設定。vars や DO の binding は上の階層から引き継がれないので、
  // プレビューでも使うものはここにも書く
  "previews": {
    "vars": {
      "SCORING_MODE": "fixed",
      "SCORE_WEIGHTS": "50,25,25",
      "SCENE_GENERATION": "off"
    },
    "durable_objects": {
      "bindings": [
        { "name": "ROOM", "class_name": "Room" },
        { "name": "SCENE_REVIEWS", "class_name": "SceneReviews" }
      ]
    }
  }
}
