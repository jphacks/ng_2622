<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ビルド構成（Config/*.xcconfig）の値が入る。AppConfig.swift で読む -->
	<key>BackendMode</key>
	<string>$(BACKEND_MODE)</string>
	<key>BackendURL</key>
	<string>$(BACKEND_URL)</string>
	<!-- 待合でのシーンの選び方（difficulty / list）。Mock.xcconfig・Live.xcconfig で決める -->
	<key>ScenePick</key>
	<string>$(SCENE_PICK)</string>
	<!-- Mock の振る舞い（Config/Mock.xcconfig）。Live では空になり、使わない -->
	<key>MockOtherPlayers</key>
	<string>$(MOCK_OTHER_PLAYERS)</string>
	<key>MockIncludesOffline</key>
	<string>$(MOCK_INCLUDES_OFFLINE)</string>
	<key>MockHostStartDelay</key>
	<string>$(MOCK_HOST_START_DELAY)</string>
	<!-- 手元のバックエンド（http://localhost:8787 や Mac の IP）に http でつなげるよう、ローカルのネットワークだけ ATS を緩める -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 実機から Mac の IP につなぐときに出る、ローカルネットワークの許可の説明 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>開発用に、同じ Wi-Fi の Mac で動かしているバックエンドにつなぐために使います。</string>
</dict>
</plist>
