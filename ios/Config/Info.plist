<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ビルド構成（Config/*.xcconfig）の値が入る。AppConfig.swift で読む -->
	<key>BackendMode</key>
	<string>$(BACKEND_MODE)</string>
	<key>BackendURL</key>
	<string>$(BACKEND_URL)</string>
	<!-- Mock の振る舞い（Config/Mock.xcconfig）。Live では空になり、使わない -->
	<key>MockOtherPlayers</key>
	<string>$(MOCK_OTHER_PLAYERS)</string>
	<key>MockIncludesOffline</key>
	<string>$(MOCK_INCLUDES_OFFLINE)</string>
	<key>MockHostStartDelay</key>
	<string>$(MOCK_HOST_START_DELAY)</string>
	<key>MockSampleRecords</key>
	<string>$(MOCK_SAMPLE_RECORDS)</string>
	<!-- 手元のバックエンド（http://localhost:8787 や Mac の IP）に http でつなげるよう、ローカルのネットワークだけ ATS を緩める -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 実機から Mac の IP につなぐときのローカルネットワークの許可の説明は、開発の構成だけに入れる（project.yml の configs） -->
</dict>
</plist>
