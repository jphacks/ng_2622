// scheme「NG2622 Mock」のビルド構成。仮のデータで動き、通信しない
#include "Shared.xcconfig"

BACKEND_MODE = mock

// 仮のデータの振る舞い。変えるときは Local.xcconfig に書く（書き方は Local.xcconfig.example）
// 自分のほかの参加者の数（0〜7）。部屋に入るときは、うち 1 人がホストになる（0 でも 1 人はいる）
MOCK_OTHER_PLAYERS = 3
// ほかの参加者の 1 人がラウンドの途中で切断する（YES / NO）
MOCK_INCLUDES_OFFLINE = NO
// 部屋に入ったあと、ホストがスタートするまでの秒数
MOCK_HOST_START_DELAY = 6
// スタートしてから、場面を作り終えてラウンドが始まるまでの秒数（場面を作っているふり）
MOCK_GENERATING_DURATION = 3
// きろくの画面に初めから出す例の記録の数（0 で出さない）。端末には書かず、「すべて消す」で一緒に消える（開き直すと戻る）
MOCK_SAMPLE_RECORDS = 12
// 苦手の分析（3 秒待ってから返す）。ok: 癖 2 件など / empty: 癖が 0 件 / fail: 作れない / limit: 回数の上限
MOCK_WEAK_POINTS = ok
// 苦手の場面（分析が届いてから 4 秒待って、作り置きの場面の一つを返す）。ok / fail: 作れない / limit: 回数の上限 /
// off: 止めている / offline: 通信できない / missing: 作れたが、スタートすると部屋が断る（置き場に無い）
MOCK_WEAK_SCENE = ok

// 各自の設定で上書きする（無くてもよい）
#include? "Local.xcconfig"
