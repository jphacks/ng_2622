// 各自の署名の設定。このファイルを Local.xcconfig という名前で写し、自分の値を書く
// Local.xcconfig は .gitignore 済みで、commit しない
//   cp ios/Config/Local.xcconfig.example ios/Config/Local.xcconfig

// Apple Developer のチーム ID（Xcode の Settings > Accounts か、developer.apple.com の Membership で見られる）
DEVELOPMENT_TEAM = XXXXXXXXXX

// bundle ID は世界で 1 つしか登録できないので、メンバーごとに変える（例: 末尾に自分の名前）
PRODUCT_BUNDLE_IDENTIFIER = jp.jphacks.ng2622.yourname

// 任意: Live でつなぐ先を PR のプレビューに変える。// はコメントになるので https:/$()/ と書く
// BACKEND_URL = https:/$()/pr-12-ng-2622-backend.jphacks-ng2622.workers.dev
// 任意: Live で手元のバックエンド（cd backend && pnpm dev）につなぐ。シミュレータからは localhost で届く
// BACKEND_URL = http:/$()/localhost:8787
// 実機の iPhone からは、iPhone 自身を指す localhost では Mac に届かない。同じ Wi-Fi で Mac の IP を書き、
// バックエンドを外から受けられるように起動する（cd backend && pnpm dev --ip 0.0.0.0）。
// http で IP につなぐのは Info.plist の NSAllowsLocalNetworking で許していて、初回はローカルネットワークの許可を聞かれる
// BACKEND_URL = http:/$()/192.168.1.23:8787

// 任意: Mock の振る舞いを変える（既定値は Mock.xcconfig）。アプリの画面には切り替えを置かない
// MOCK_OTHER_PLAYERS = 3        // 自分のほかの参加者の数（0〜7）
// MOCK_INCLUDES_OFFLINE = YES   // ほかの参加者の 1 人がラウンドの途中で切断する
// MOCK_HOST_START_DELAY = 6     // 部屋に入ったあと、ホストがスタートするまでの秒数
// 部屋に入る画面では、コード 0000 だけが「部屋が見つかりません」になり、ほかの 4 桁は入れる

// 任意: 待合でのシーンの選び方を変える（既定は Mock も Live も difficulty）。ここに書くと Mock と Live の両方に効く
// SCENE_PICK = list             // difficulty（難易度だけを選ぶ）か list（手作りのシーンの一覧）
